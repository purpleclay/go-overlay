# Version selection and the metadata built from manifests: go-bin's entry
# points, version parsing, the Go and tool index.nix files, versionInfo and
# toolInfo. Almost all of it is evaluation only.
{
  pkgs,
  packageNames,
  ...
}: let
  inherit (import ./lib.nix {inherit pkgs;}) assertEq go-bin testBinaryExists toolInfo toolManifests versionInfo versionLib;

  # manifests/go/index.nix is regenerated by goscrape whenever it writes a Go
  # manifest; these compare it against the per-version files it summarises.
  goIndex = import ../manifests/go/index.nix;
  goManifestsLib = import ../lib/manifests.nix {lib = pkgs.lib;};
  goManifests = goManifestsLib.manifests;

  # go-bin built with every per-version manifest except the latest and latest
  # stable replaced by a throw. An entry point that evaluates against it
  # imports no other manifest; one that forces a different version fails.
  lazyAllowedManifests = map (v: "${v}.nix") [goManifestsLib.latest goManifestsLib.latestStable];
  lazyGoBin = import ../lib {
    inherit (pkgs) lib;
    inherit pkgs;
    importManifest = path:
      if builtins.elem (baseNameOf path) lazyAllowedManifests
      then import path
      else throw "go-overlay test: imported ${baseNameOf path}";
  };
  evaluates = expr: (builtins.tryEval (builtins.deepSeq expr expr)).success;
  latestGoMod = builtins.toFile "go.mod" "module example.com/lazy\n\ngo ${goManifestsLib.latest}\n";
  versionInfoMinors = pkgs.lib.unique (map (r: r.minor) versionInfo);

  # toolInfo built with every per-version tool manifest replaced by a throw, so
  # it only evaluates if it reads nothing but the index.nix files.
  lazyToolInfo = import ../lib/tool-info.nix {
    inherit (pkgs) lib;
    toolManifests = import ../lib/tool-manifests.nix {
      inherit (pkgs) lib;
      importManifest = path: throw "go-overlay test: imported ${baseNameOf path}";
    };
  };
  toolInfoRecord = tool: version: pkgs.lib.findFirst (r: r.version == version) null toolInfo.${tool};

  # Asserts that evaluating expr throws, rather than silently producing a
  # value (e.g. a malformed version string that should be rejected).
  assertThrows = name: expr: let
    result = builtins.tryEval expr;
  in
    if !result.success
    then pkgs.runCommand "test-${name}-pass" {} "touch $out"
    else
      pkgs.runCommand "test-${name}-fail" {} ''
        echo "Test '${name}' failed: expected an error but evaluation succeeded"
        exit 1
      '';
in {
  # latest
  latest-exists = assertEq "latest-exists" true (builtins.stringLength go-bin.latest.version > 0);
  latest-has-go-binary = testBinaryExists "latest-has-go-binary" go-bin.latest "bin/go";

  # latestStable
  latestStable-exists = assertEq "latestStable-exists" true (builtins.stringLength go-bin.latestStable.version > 0);
  latestStable-not-rc = assertEq "latestStable-not-rc" null (builtins.match ".*rc[0-9]+" go-bin.latestStable.version);
  latestStable-has-go-binary = testBinaryExists "latestStable-has-go-binary" go-bin.latestStable "bin/go";

  # versions
  versions-is-attrset = assertEq "versions-is-attrset" true (builtins.isAttrs go-bin.versions);
  versions-not-empty = assertEq "versions-not-empty" true (builtins.length (builtins.attrNames go-bin.versions) > 0);
  versions-contains-known = assertEq "versions-contains-known" true (builtins.hasAttr "1.21.4" go-bin.versions);
  versions-derivation-has-go-binary = testBinaryExists "versions-derivation-has-go-binary" go-bin.versions."1.21.4" "bin/go";

  # manifests/go/index.nix
  go-index-lists-every-manifest-version =
    assertEq "go-index-lists-every-manifest-version" {
      missingFromIndex = [];
      notInManifests = [];
    } {
      missingFromIndex = builtins.filter (v: !(goIndex ? ${v})) (builtins.attrNames goManifests);
      notInManifests = builtins.filter (v: !(goManifests ? ${v})) (builtins.attrNames goIndex);
    };
  go-index-dates-match-manifests =
    assertEq "go-index-dates-match-manifests" []
    (builtins.filter (v: goIndex ? ${v} && goIndex.${v}.date != goManifests.${v}.date) (builtins.attrNames goManifests));

  # Each tool's index.nix is regenerated by goscrape whenever it writes a tool
  # manifest; lists "<tool> <version>" for every index date that is missing or
  # differs from the version's manifest.
  tool-index-dates-match-manifests =
    assertEq "tool-index-dates-match-manifests" []
    (pkgs.lib.concatLists (pkgs.lib.mapAttrsToList (
        name: tool:
          map (v: "${name} ${v}") (builtins.filter (v: (tool.index.${v}.date or null) != tool.manifests.${v}.date) tool.sortedVersions)
      )
      toolManifests.tools));

  # lazy manifest loading
  lazy-manifests-entry-points-import-only-what-they-need =
    assertEq "lazy-manifests-entry-points-import-only-what-they-need" {
      latest = true;
      latestStable = true;
      fromGoMod = true;
      fromGoModStrict = true;
      hasVersion = true;
      isDeprecated = true;
      versionInfo = true;
    } {
      latest = evaluates lazyGoBin.latest.drvPath;
      latestStable = evaluates lazyGoBin.latestStable.drvPath;
      fromGoMod = evaluates (lazyGoBin.fromGoMod latestGoMod).drvPath;
      fromGoModStrict = evaluates (lazyGoBin.fromGoModStrict latestGoMod).drvPath;
      hasVersion = evaluates (lazyGoBin.hasVersion "1.21.4");
      isDeprecated = evaluates (lazyGoBin.isDeprecated "1.21.4");
      versionInfo = evaluates lazyGoBin.versionInfo;
    };
  # Control: proves the guard's throw fires, so the check above can't pass
  # because nothing ever throws.
  lazy-manifests-guard-rejects-another-version =
    assertEq "lazy-manifests-guard-rejects-another-version" false
    (evaluates lazyGoBin.versions.${pkgs.lib.last goManifestsLib.sortedVersions}.drvPath);

  # versionInfo
  versionInfo-lists-every-version = assertEq "versionInfo-lists-every-version" goManifestsLib.sortedVersions (map (r: r.version) versionInfo);
  versionInfo-sorted-newest-first =
    assertEq "versionInfo-sorted-newest-first" []
    (builtins.filter (p: versionLib.compareVersions p.fst p.snd <= 0)
      (pkgs.lib.zipLists (map (r: r.version) versionInfo) (map (r: r.version) (builtins.tail versionInfo))));
  versionInfo-one-newest-per-minor =
    assertEq "versionInfo-one-newest-per-minor"
    # the first record of each minor in a newest-first list is its newest release
    (map (m: (pkgs.lib.findFirst (r: r.minor == m) null versionInfo).version) versionInfoMinors)
    (map (r: r.version) (builtins.filter (r: r.newestInMinor) versionInfo));
  versionInfo-latest-matches-go-bin =
    assertEq "versionInfo-latest-matches-go-bin" [go-bin.latest.version]
    (map (r: r.version) (builtins.filter (r: r.status == "latest") versionInfo));
  versionInfo-stable-matches-go-bin =
    assertEq "versionInfo-stable-matches-go-bin"
    (
      if go-bin.latestStable.version == go-bin.latest.version
      then []
      else [go-bin.latestStable.version]
    )
    (map (r: r.version) (builtins.filter (r: r.status == "stable") versionInfo));
  versionInfo-eol-matches-isDeprecated =
    assertEq "versionInfo-eol-matches-isDeprecated" []
    (builtins.filter (r: !(builtins.elem r.status ["latest" "stable"]) && (r.status == "eol") != go-bin.isDeprecated r.version) versionInfo);
  versionInfo-prerelease-is-a-supported-rc-or-beta =
    assertEq "versionInfo-prerelease-is-a-supported-rc-or-beta" []
    (builtins.filter (r: builtins.elem r.status ["prerelease" "supported"] && (r.status == "prerelease") != ((versionLib.parseVersion r.version).stage < 2)) versionInfo);
  versionInfo-rc-of-eol-minor-is-eol =
    assertEq "versionInfo-rc-of-eol-minor-is-eol" "eol"
    (pkgs.lib.findFirst (r: r.version == "1.19rc1") {status = "missing";} versionInfo).status;
  versionInfo-attr-is-a-flake-package =
    assertEq "versionInfo-attr-is-a-flake-package" []
    (builtins.filter (r: !(builtins.elem r.attr packageNames)) versionInfo);
  versionInfo-dates-match-index =
    assertEq "versionInfo-dates-match-index" []
    (builtins.filter (r: r.date != goIndex.${r.version}.date) versionInfo);
  # String context would mean a record references a store path, i.e. that
  # evaluating versionInfo instantiated a derivation.
  versionInfo-references-no-derivation = assertEq "versionInfo-references-no-derivation" false (builtins.hasContext (builtins.toJSON versionInfo));

  # toolInfo
  toolInfo-lists-every-tool = assertEq "toolInfo-lists-every-tool" (builtins.attrNames toolManifests.tools) (builtins.attrNames toolInfo);
  # The same newest-first order go.tools.<name>.latest resolves from
  toolInfo-matches-overlay-order =
    assertEq "toolInfo-matches-overlay-order"
    (builtins.mapAttrs (_: t: t.sortedVersions) toolManifests.tools)
    (builtins.mapAttrs (_: map (r: r.version)) toolInfo);
  toolInfo-indexes-list-every-version =
    assertEq "toolInfo-indexes-list-every-version"
    (builtins.mapAttrs (_: t: builtins.sort builtins.lessThan t.sortedVersions) toolManifests.tools)
    (builtins.mapAttrs (_: t: builtins.attrNames t.index) toolManifests.tools);
  toolInfo-stable-record =
    assertEq "toolInfo-stable-record" {
      tool = "gopls";
      version = "0.24.0";
      date = "2026-10-14";
      minor = "0.24";
      prerelease = false;
      go = "1.27.0";
      license = "BSD-3-Clause";
    }
    (builtins.removeAttrs (toolInfoRecord "gopls" "0.24.0") ["goVersion"]);
  toolInfo-prerelease-record = assertEq "toolInfo-prerelease-record" true (toolInfoRecord "gopls" "0.24.0-pre.3").prerelease;
  toolInfo-parses-min-go = assertEq "toolInfo-parses-min-go" (versionLib.parseVersion "1.25") (toolInfoRecord "gopls" "0.21.1").goVersion;
  toolInfo-reads-only-indexes = assertEq "toolInfo-reads-only-indexes" true (evaluates lazyToolInfo);
  toolInfo-references-no-derivation = assertEq "toolInfo-references-no-derivation" false (builtins.hasContext (builtins.toJSON toolInfo));

  # hasVersion
  hasVersion-exact = assertEq "hasVersion-exact" true (go-bin.hasVersion "1.21.4");
  hasVersion-partial-fails = assertEq "hasVersion-partial-fails" false (go-bin.hasVersion "1.21");
  hasVersion-nonexistent = assertEq "hasVersion-nonexistent" false (go-bin.hasVersion "1.99.0");
  hasVersion-rc = assertEq "hasVersion-rc" true (go-bin.hasVersion "1.25rc1");
  hasVersion-beta = assertEq "hasVersion-beta" true (go-bin.hasVersion "1.19beta1");

  # isDeprecated
  isDeprecated-old = assertEq "isDeprecated-old" true (go-bin.isDeprecated "1.17.0");
  isDeprecated-latest-stable = assertEq "isDeprecated-latest-stable" false (go-bin.isDeprecated go-bin.latestStable.version);
  # A beta or rc of an EOL minor line is deprecated just like its stable
  # sibling - pre-release stage grants no exemption from the minor-version window.
  isDeprecated-beta-of-eol-minor = assertEq "isDeprecated-beta-of-eol-minor" true (go-bin.isDeprecated "1.19beta1");
  isDeprecated-rc-of-eol-minor = assertEq "isDeprecated-rc-of-eol-minor" true (go-bin.isDeprecated "1.19rc1");

  # latestStable must never resolve to a beta, mirroring latestStable-not-rc
  latestStable-not-beta = assertEq "latestStable-not-beta" null (builtins.match ".*beta[0-9]+" go-bin.latestStable.version);

  # version parsing/comparison - beta ordering (go-overlay#576)
  version-parses-beta = assertEq "version-parses-beta" {
    major = 1;
    minor = 19;
    patch = 0;
    stage = 0;
    counter = 1;
  } (versionLib.parseVersion "1.19beta1");

  version-beta-sorts-below-rc =
    assertEq "version-beta-sorts-below-rc" true
    (versionLib.compareVersions "1.19beta1" "1.19rc1" < 0);

  version-beta-sorts-below-stable =
    assertEq "version-beta-sorts-below-stable" true
    (versionLib.compareVersions "1.19beta1" "1.19" < 0);

  version-beta-counter-ordering =
    assertEq "version-beta-counter-ordering" true
    (versionLib.compareVersions "1.19beta1" "1.19beta2" < 0);

  # A beta of a newer minor still outranks a stable release of an older minor,
  # mirroring the existing rc behaviour (major/minor/patch are compared before
  # the rc/beta tiebreak).
  version-beta-outranks-older-stable-minor =
    assertEq "version-beta-outranks-older-stable-minor" true
    (versionLib.compareVersions "1.20beta1" "1.19.5" > 0);

  # Boundary regression (coderabbitai, go-overlay#577): a fixed numeric band
  # per stage overlaps once a counter is large enough (previously
  # "1.19beta1001" and "1.19rc1" both collapsed to rc = -999, comparing
  # equal). Stage and counter must be compared as separate tiers so no
  # counter magnitude can cross into the next stage's range.
  version-beta-large-counter-still-below-rc =
    assertEq "version-beta-large-counter-still-below-rc" true
    (versionLib.compareVersions "1.19beta1001" "1.19rc1" < 0);

  version-rc-large-counter-still-below-stable =
    assertEq "version-rc-large-counter-still-below-stable" true
    (versionLib.compareVersions "1.19rc1000" "1.19" < 0);

  # Rejection (coderabbitai, go-overlay#577): "1.19beta1.4" and "1.19rc1.4"
  # pass the length check and match hasBeta/hasRc against minorPart alone,
  # so the trailing ".4" was silently dropped and the version compared equal
  # to "1.19beta1"/"1.19rc1" - patch-level prereleases aren't a real Go
  # version shape (rc/beta only ever apply to a new minor line), so they
  # must be rejected outright rather than silently truncated.
  version-rejects-beta-with-patch =
    assertThrows "version-rejects-beta-with-patch"
    (versionLib.parseVersion "1.19beta1.4");

  version-rejects-rc-with-patch =
    assertThrows "version-rejects-rc-with-patch"
    (versionLib.parseVersion "1.19rc1.4");

  # fromGoMod
  fromGoMod-with-toolchain = assertEq "fromGoMod-with-toolchain" "1.21.6" (go-bin.fromGoMod ./fixtures/go-with-toolchain.mod).version;
  fromGoMod-exact = assertEq "fromGoMod-exact" "1.21.4" (go-bin.fromGoMod ./fixtures/go-exact.mod).version;
  fromGoMod-minor-only = assertEq "fromGoMod-minor-only" true (pkgs.lib.hasPrefix "1.21." (go-bin.fromGoMod ./fixtures/go-minor-only.mod).version);

  # fromGoModStrict
  fromGoModStrict-with-toolchain = assertEq "fromGoModStrict-with-toolchain" "1.21.6" (go-bin.fromGoModStrict ./fixtures/go-with-toolchain.mod).version;
  fromGoModStrict-exact = assertEq "fromGoModStrict-exact" "1.21.4" (go-bin.fromGoModStrict ./fixtures/go-exact.mod).version;
}
